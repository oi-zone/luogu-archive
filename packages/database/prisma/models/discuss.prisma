model Post {
  id         Int      @id
  time       DateTime @db.Timestamp(0)
  replyCount Int
  public     Boolean  @default(false)

  visibilityState     String    @default("unverified")
  visibilityCheckedAt DateTime?
  visibilitySource    String?
  visibilityVersion   Int       @default(1)

  updatedAt DateTime

  snapshots PostSnapshot[]
  replies   Reply[]

  takedown PostTakedown?

  @@index([time])
  @@index([replyCount(sort: Desc)])
  @@index([public, updatedAt(sort: Desc)])
  @@index([visibilityCheckedAt, id], map: "Post_visibility_revalidation_idx")
}

model PostSnapshot {
  post   Post @relation(fields: [postId], references: [id])
  postId Int

  title     String
  author    User   @relation(fields: [authorId], references: [id])
  authorId  Int
  forum     Forum  @relation(fields: [forumSlug], references: [slug])
  forumSlug String

  topped Boolean
  locked Boolean

  content String @db.Text

  exposureState    String    @default("unverified")
  verifiedPublicAt DateTime?
  verifiedSource   String?

  pinnedReply   Reply? @relation(fields: [pinnedReplyId], references: [id])
  pinnedReplyId Int?

  capturedAt DateTime
  lastSeenAt DateTime

  @@id([postId, capturedAt])
  @@index([postId])
  @@index([authorId])
  @@index([postId, capturedAt(sort: Desc)])
  @@index([postId, exposureState, capturedAt(sort: Desc)], map: "PostSnapshot_exposure_idx")
}

model PostTakedown {
  post   Post @relation(fields: [postId], references: [id])
  postId Int  @id

  submitter   User @relation(fields: [submitterId], references: [id])
  submitterId Int

  reason String
}

model Reply {
  id Int @id

  post   Post @relation(fields: [postId], references: [id])
  postId Int

  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  time DateTime @db.Timestamp(0)

  snapshots ReplySnapshot[]
  takedown  ReplyTakedown?

  pinnedTo PostSnapshot[]

  @@index([postId])
  @@index([authorId])
  @@index([time])
}

model ReplySnapshot {
  reply   Reply @relation(fields: [replyId], references: [id])
  replyId Int

  content String @db.Text

  exposureState    String    @default("unverified")
  verifiedPublicAt DateTime?
  verifiedSource   String?

  capturedAt DateTime
  lastSeenAt DateTime

  @@id([replyId, capturedAt])
  @@index([replyId])
  @@index([replyId, capturedAt(sort: Desc)])
  @@index([replyId, exposureState, capturedAt(sort: Desc)], map: "ReplySnapshot_exposure_idx")
}

model ReplyTakedown {
  reply   Reply @relation(fields: [replyId], references: [id])
  replyId Int   @id

  submitter   User @relation(fields: [submitterId], references: [id])
  submitterId Int

  reason String
}

model Forum {
  name  String
  type  Int?
  slug  String  @id
  color String?

  problem   Problem? @relation(fields: [problemId], references: [pid])
  problemId String?  @unique

  updatedAt DateTime

  postSnapshots PostSnapshot[]
}
