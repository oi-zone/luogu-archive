model Article {
  lid String @id @db.Char(8)

  time       DateTime @db.Timestamp(0)
  author     User     @relation(fields: [authorId], references: [id])
  authorId   Int
  upvote     Int
  replyCount Int
  favorCount Int
  public     Boolean  @default(false)

  visibilityState     String    @default("unverified")
  visibilityCheckedAt DateTime?
  visibilitySource    String?
  visibilityVersion   Int       @default(1)

  updatedAt DateTime

  snapshots ArticleSnapshot[]
  replies   ArticleReply[]

  copra ArticleCopra?

  @@index([time])
  @@index([authorId])
  @@index([upvote(sort: Desc)])
  @@index([replyCount(sort: Desc)])
  @@index([favorCount(sort: Desc)])
  @@index([public, updatedAt(sort: Desc)])
  @@index([visibilityCheckedAt, lid], map: "Article_visibility_revalidation_idx")
}

model ArticleSnapshot {
  article   Article @relation(fields: [articleId], references: [lid])
  articleId String  @db.Char(8)

  title String

  category       Int
  status         Int
  solutionFor    Problem?           @relation(fields: [solutionForPid], references: [pid])
  solutionForPid String?
  promoteStatus  Int
  collection     ArticleCollection? @relation(fields: [collectionId], references: [id])
  collectionId   Int?

  content String @db.Text

  adminNote String?

  exposureState    String    @default("unverified")
  verifiedPublicAt DateTime?
  verifiedSource   String?

  capturedAt DateTime
  lastSeenAt DateTime

  @@id([articleId, capturedAt])
  @@index([articleId])
  @@index([articleId, capturedAt(sort: Desc)])
  @@index([articleId, exposureState, capturedAt(sort: Desc)], map: "ArticleSnapshot_exposure_idx")
}

model ArticleCollection {
  id   Int    @id
  name String

  articleSnapshots ArticleSnapshot[]
}

model ArticleReply {
  id        Int      @id
  article   Article  @relation(fields: [articleId], references: [lid])
  articleId String   @db.Char(8)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  time      DateTime @db.Timestamp(0)
  content   String

  exposureState    String    @default("unverified")
  verifiedPublicAt DateTime?
  verifiedSource   String?

  updatedAt DateTime

  @@index([articleId])
  @@index([authorId])
  @@index([time])
}

model ArticleCopra {
  article   Article @relation(fields: [articleId], references: [lid])
  articleId String  @id

  summary String? @db.Text
  tags    Json?
}
