{
  "name": "luogu-discussion-archive",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare": "husky",
    "build": "turbo build",
    "lint": "pnpm --filter @luogu-discussion-archive/db db:generate && pnpm --filter web lint && eslint apps/worker/src packages/crawler/src packages/database/src packages/logging/src packages/query/src packages/queue/src --ignore-pattern '**/generated/**'",
    "typecheck": "pnpm --filter @luogu-discussion-archive/db db:generate && turbo typecheck",
    "test": "turbo build --filter=!web && node --test --test-concurrency=1 packages/remark-lda-lfm/tests/*.test.mjs tests/*.test.mjs",
    "archive:enqueue": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/archive-enqueue.js",
    "queue:doctor": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/queue-maintenance.js",
    "queue:repair": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/queue-maintenance.js --repair",
    "queue:retire": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/queue-maintenance.js --retire-legacy",
    "privacy:audit": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/privacy-audit.js",
    "visibility:audit": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/visibility-audit.js",
    "visibility:revalidate": "turbo build --filter=@luogu-discussion-archive/worker... && node apps/worker/dist/visibility-revalidate.js"
  },
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^20.19.27",
    "@wangxinhe/eslint-config": "^0.4.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  }
}
